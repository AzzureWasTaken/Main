# Copy this file to .env and fill in the values.

# A long random string used to sign login sessions.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# "ses" sends real email through Amazon SES.
# "console" only logs emails and fakes delivery events - use it to try the app out.
MAIL_BACKEND=console

# AWS credentials for an IAM user with SES, SNS and SQS access (see README).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# Names of the AWS resources. `python manage.py setup-aws` creates them.
SES_CONFIGURATION_SET=mailer
SES_CONTACT_LIST=mailer-contacts
SQS_QUEUE_NAME=mailer-events

# Address and port the web dashboard listens on.
# 0.0.0.0 lets teammates on your network (or Tailscale) connect.
HOST=0.0.0.0
PORT=8080
