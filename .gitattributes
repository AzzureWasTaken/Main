# The MineXVideo skill ships from a Windows zip; its shell scripts break with
# CRLF ("set -euo pipefail\r" is an invalid option). Keep these LF everywhere.
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
python3-shim text eol=lf

# Source and rendered video goes through Git LFS. Set up BEFORE the first
# large file lands: once a video is a normal blob it is in history forever,
# and getting it out means rewriting history and breaking every clone.
# The banner assets under ads/ predate this and stay as ordinary blobs.
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.mkv  filter=lfs diff=lfs merge=lfs -text
*.m4v  filter=lfs diff=lfs merge=lfs -text
*.avi  filter=lfs diff=lfs merge=lfs -text
