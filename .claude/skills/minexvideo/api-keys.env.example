# MineXVideo — API keys
# The ONLY key this skill needs. Used to generate sound effects, music and
# character voices with ElevenLabs.
#
# SETUP: copy this file to api-keys.env in the same directory and fill in the
# key. api-keys.env is gitignored and never committed.
#
#   cp api-keys.env.example api-keys.env
#
# Alternatively, export ELEVENLABS_API_KEY in your shell and the scripts will
# pick it up without this file.
ELEVENLABS_API_KEY=
